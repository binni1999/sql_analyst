# Application
APP_NAME=Multi-Agent SQL Data Analyst
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database
# Local host example:
DATABASE_URL=postgresql+psycopg2://postgres:root123@localhost:5432/datapilot
# LangGraph uses this URL when provided; otherwise DATABASE_URL is reused.
LANGGRAPH_CHECKPOINT_DB_URL=postgresql://postgres:root123@localhost:5432/datapilot

# Docker Compose PostgreSQL settings (local container defaults)
# Keep these aligned with the credentials used by the local PostgreSQL container.
POSTGRES_DB=datapilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root123

# Frontend/API access
CORS_ORIGINS=http://localhost:5173

# Redis
# Local host example:
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# LLM/provider secrets
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
HUGGINGFACEHUB_API_KEY=

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_END_POINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# SQLAlchemy connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
