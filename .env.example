OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
HUGGINGFACEHUB_API_KEY=

DATABASE_URL=
LANGSMITH_TRACING="true" 
LANGSMITH_END_POINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="DataPilot"



# Application
APP_NAME=Multi-Agent SQL Data Analyst
APP_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database
# Local host example:
DATABASE_URL=postgresql+psycopg2://postgres:<>@localhost:5432/datapilot
# LangGraph uses this URL when provided; otherwise DATABASE_URL is reused.
LANGGRAPH_CHECKPOINT_DB_URL=postgresql://postgres:<>@localhost:5432/datapilot

POSTGRES_DB=datapilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<>
# Frontend/API access
CORS_ORIGINS=http://localhost:5173


# Redis
# Local host example:
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_MAX_CONNECTIONS=20
REDIS_SCHEMA_CACHE_VERSION=v2


# LLM/provider secrets
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# TAVILY_API_KEY=
# HUGGINGFACEHUB_API_KEY=

# Optional LangSmith tracing
# LANGSMITH_TRACING=false
# LANGSMITH_END_POINT=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# SQLAlchemy connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true


# Logging
# auto = JSON in production, human-readable text in development.
LOG_FORMAT=auto
REQUEST_LOGGING=true


READONLY_DATABASE_URL=postgresql+psycopg2://datapilot_readonly:<>@localhost:5433/datapilot
READONLY_DB_USER=datapilot_readonly
READONLY_DB_PASSWORD=<>

# Groq GPT-OSS 120B pricing in USD per 1 million tokens
OBSERVABILITY_INPUT_COST_PER_1M=0.15
OBSERVABILITY_OUTPUT_COST_PER_1M=0.60
